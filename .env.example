# Copying this file is useful for reviewing required variables. Prefer `make dev-env`
# to generate strong local-only values automatically.
ENVIRONMENT=development
# Explicit dev/test opt-in only. Always disabled in production (pilot D2).
UPLOADS_ENABLED=false
AUTH_MODE=development
APP_ORIGIN=http://oligospace.localhost:8080
APP_PORT=8080
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_CLIENT_SECRET=
DEVELOPMENT_USER_PASSWORD=
MINIO_ROOT_USER=oligospace-local
MINIO_ROOT_PASSWORD=
