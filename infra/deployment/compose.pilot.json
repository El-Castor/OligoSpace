{
  "name": "${PILOT_PROJECT:?required outside Git}",
  "services": {
    "postgres": {
      "image": "${POSTGRES_IMAGE:?required outside Git}",
      "restart": "unless-stopped",
      "networks": [
        "data"
      ],
      "environment": {
        "POSTGRES_DB": "postgres",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "${POSTGRES_BOOTSTRAP_PASSWORD:?required outside Git}"
      },
      "volumes": [
        "postgres_data:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres -d postgres"
        ],
        "interval": "2s",
        "timeout": "3s",
        "retries": 30
      },
      "user": "70:70",
      "mem_limit": "1024m",
      "cpus": "1.0",
      "pids_limit": 160,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777",
        "/var/run/postgresql:rw,nosuid,noexec,size=8m,uid=70,gid=70,mode=0775"
      ]
    },
    "migrate": {
      "image": "${API_IMAGE:?required outside Git}",
      "restart": "no",
      "networks": [
        "data"
      ],
      "profiles": [
        "operations"
      ],
      "command": [
        "/opt/venv/bin/python",
        "-m",
        "alembic",
        "upgrade",
        "head"
      ],
      "environment": {
        "ENVIRONMENT": "production",
        "AUTH_MODE": "oidc",
        "UPLOADS_ENABLED": "false",
        "DATABASE_URL": "${MIGRATION_DATABASE_URL:?required outside Git}",
        "OIDC_ISSUER": "${OIDC_ISSUER:?required outside Git}",
        "OIDC_AUDIENCE": "${OIDC_AUDIENCE:?required outside Git}",
        "OIDC_CLIENT_ID": "${OIDC_CLIENT_ID:?required outside Git}",
        "OIDC_CLIENT_SECRET": "${OIDC_CLIENT_SECRET:?required outside Git}",
        "CORS_ORIGINS": "[\"${APP_ORIGIN:?required outside Git}\"]",
        "OBJECT_STORAGE_ENDPOINT": "object-store:9000",
        "OBJECT_STORAGE_ACCESS_KEY": "${S3_ACCESS_KEY:?required outside Git}",
        "OBJECT_STORAGE_SECRET_KEY": "${S3_SECRET_KEY:?required outside Git}",
        "OBJECT_STORAGE_BUCKET": "${S3_BUCKET:?required outside Git}",
        "OBJECT_STORAGE_SECURE": "false",
        "REDIS_URL": "${REDIS_URL:?required outside Git}",
        "SSL_CERT_FILE": "/certs/ca.pem",
        "REQUESTS_CA_BUNDLE": "/certs/ca.pem"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "user": "1000:1000",
      "mem_limit": "512m",
      "cpus": "0.5",
      "pids_limit": 96,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "${TLS_CA:?required outside Git}",
          "target": "/certs/ca.pem",
          "read_only": true
        }
      ]
    },
    "redis": {
      "image": "${REDIS_IMAGE:?required outside Git}",
      "restart": "unless-stopped",
      "networks": [
        "data"
      ],
      "command": [
        "redis-server",
        "--appendonly",
        "yes",
        "--requirepass",
        "${REDIS_PASSWORD:?required outside Git}"
      ],
      "environment": {
        "REDISCLI_AUTH": "${REDIS_PASSWORD:?required outside Git}"
      },
      "volumes": [
        "redis_data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 20
      },
      "user": "999:1000",
      "mem_limit": "256m",
      "cpus": "0.5",
      "pids_limit": 80,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777"
      ]
    },
    "object-store": {
      "image": "${MINIO_IMAGE:?required outside Git}",
      "restart": "unless-stopped",
      "networks": [
        "data"
      ],
      "command": [
        "server",
        "/data",
        "--console-address",
        ":9001"
      ],
      "environment": {
        "MINIO_ROOT_USER": "${S3_ADMIN_USER:?required outside Git}",
        "MINIO_ROOT_PASSWORD": "${S3_ADMIN_PASSWORD:?required outside Git}"
      },
      "volumes": [
        "object_data:/data"
      ],
      "user": "1000:1000",
      "mem_limit": "1024m",
      "cpus": "1.0",
      "pids_limit": 160,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "--fail",
          "--max-time",
          "5",
          "http://localhost:9000/minio/health/ready"
        ],
        "interval": "10s",
        "timeout": "6s",
        "retries": 12,
        "start_period": "30s"
      }
    },
    "keycloak": {
      "image": "${KEYCLOAK_IMAGE:?required outside Git}",
      "restart": "unless-stopped",
      "networks": [
        "application",
        "data"
      ],
      "command": [
        "--config-file=/etc/oligospace/keycloak.conf",
        "start"
      ],
      "environment": {
        "KC_DB": "postgres",
        "KC_DB_URL": "jdbc:postgresql://postgres:5432/keycloak",
        "KC_DB_USERNAME": "${KEYCLOAK_DB_USER:?required outside Git}",
        "KC_DB_PASSWORD": "${KEYCLOAK_DB_PASSWORD:?required outside Git}",
        "KC_HOSTNAME": "${APP_ORIGIN:?required outside Git}",
        "KC_HTTP_ENABLED": "true",
        "KC_PROXY_HEADERS": "xforwarded",
        "KC_HTTP_RELATIVE_PATH": "/",
        "KC_HEALTH_ENABLED": "true",
        "KC_METRICS_ENABLED": "false",
        "KC_HOSTNAME_STRICT": "true",
        "KC_PROXY_TRUSTED_ADDRESSES": "${PROXY_TRUSTED_CIDRS:?required outside Git}",
        "JAVA_OPTS_KC_HEAP": "-Xms128m -Xmx640m"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "${KEYCLOAK_CONFIG:?required outside Git}",
          "target": "/etc/oligospace/keycloak.conf",
          "read_only": true
        }
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "user": "1000:0",
      "mem_limit": "1024m",
      "cpus": "1.0",
      "pids_limit": 256,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": false,
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "bash",
          "-ec",
          "exec 3<>/dev/tcp/127.0.0.1/9000; printf \"GET /health/ready HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n\" >&3; grep -q \"200 OK\" <&3"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "90s"
      }
    },
    "api": {
      "image": "${API_IMAGE:?required outside Git}",
      "restart": "unless-stopped",
      "networks": [
        "application",
        "data"
      ],
      "environment": {
        "ENVIRONMENT": "production",
        "AUTH_MODE": "oidc",
        "UPLOADS_ENABLED": "false",
        "DATABASE_URL": "${APP_DATABASE_URL:?required outside Git}",
        "OIDC_ISSUER": "${OIDC_ISSUER:?required outside Git}",
        "OIDC_AUDIENCE": "${OIDC_AUDIENCE:?required outside Git}",
        "OIDC_CLIENT_ID": "${OIDC_CLIENT_ID:?required outside Git}",
        "OIDC_CLIENT_SECRET": "${OIDC_CLIENT_SECRET:?required outside Git}",
        "CORS_ORIGINS": "[\"${APP_ORIGIN:?required outside Git}\"]",
        "OBJECT_STORAGE_ENDPOINT": "object-store:9000",
        "OBJECT_STORAGE_ACCESS_KEY": "${S3_ACCESS_KEY:?required outside Git}",
        "OBJECT_STORAGE_SECRET_KEY": "${S3_SECRET_KEY:?required outside Git}",
        "OBJECT_STORAGE_BUCKET": "${S3_BUCKET:?required outside Git}",
        "OBJECT_STORAGE_SECURE": "false",
        "REDIS_URL": "${REDIS_URL:?required outside Git}",
        "SSL_CERT_FILE": "/certs/ca.pem",
        "REQUESTS_CA_BUNDLE": "/certs/ca.pem"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        },
        "object-store": {
          "condition": "service_started"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "/opt/venv/bin/python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health/live')"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12
      },
      "user": "1000:1000",
      "mem_limit": "768m",
      "cpus": "1.0",
      "pids_limit": 160,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "${TLS_CA:?required outside Git}",
          "target": "/certs/ca.pem",
          "read_only": true
        }
      ]
    },
    "web": {
      "image": "${WEB_IMAGE:?required outside Git}",
      "restart": "unless-stopped",
      "networks": [
        "application"
      ],
      "environment": {
        "AUTH_MODE": "oidc",
        "API_INTERNAL_URL": "http://api:8000/api/v1",
        "NEXTAUTH_URL": "${APP_ORIGIN:?required outside Git}",
        "NEXTAUTH_SECRET": "${NEXTAUTH_SECRET:?required outside Git}",
        "KEYCLOAK_ISSUER": "${OIDC_ISSUER:?required outside Git}",
        "KEYCLOAK_CLIENT_ID": "${OIDC_CLIENT_ID:?required outside Git}",
        "KEYCLOAK_CLIENT_SECRET": "${OIDC_CLIENT_SECRET:?required outside Git}",
        "NODE_EXTRA_CA_CERTS": "/certs/ca.pem"
      },
      "depends_on": {
        "api": {
          "condition": "service_healthy"
        }
      },
      "user": "1001:1001",
      "mem_limit": "768m",
      "cpus": "1.0",
      "pids_limit": 160,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "${TLS_CA:?required outside Git}",
          "target": "/certs/ca.pem",
          "read_only": true
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 18,
        "start_period": "30s"
      }
    },
    "bioinfo-worker": {
      "image": "${WORKER_IMAGE:?required outside Git}",
      "restart": "unless-stopped",
      "networks": [
        "data"
      ],
      "environment": {
        "DATABASE_URL": "${WORKER_DATABASE_URL:?required outside Git}",
        "REDIS_URL": "${REDIS_URL:?required outside Git}",
        "OLIGOSPACE_BUILD_ID": "${BUILD_ID:?required outside Git}"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        }
      },
      "user": "1000:1000",
      "mem_limit": "1024m",
      "cpus": "1.0",
      "pids_limit": 192,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "stop_grace_period": "120s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "/opt/venv/bin/celery",
          "--app",
          "oligospace_bioinfo.celery_app:app",
          "inspect",
          "ping",
          "--timeout",
          "5"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 5,
        "start_period": "30s"
      }
    },
    "scientific-scheduler": {
      "image": "${WORKER_IMAGE:?required outside Git}",
      "restart": "unless-stopped",
      "networks": [
        "data"
      ],
      "environment": {
        "DATABASE_URL": "${WORKER_DATABASE_URL:?required outside Git}",
        "REDIS_URL": "${REDIS_URL:?required outside Git}",
        "OLIGOSPACE_BUILD_ID": "${BUILD_ID:?required outside Git}"
      },
      "command": [
        "/opt/venv/bin/celery",
        "--app",
        "oligospace_bioinfo.celery_app:app",
        "beat",
        "--loglevel=INFO",
        "--schedule=/tmp/celerybeat-schedule",
        "--pidfile=/tmp/celerybeat.pid"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        }
      },
      "user": "1000:1000",
      "mem_limit": "256m",
      "cpus": "0.5",
      "pids_limit": 80,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "/opt/venv/bin/python",
          "-c",
          "import os; os.kill(1,0)"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      }
    },
    "caddy": {
      "image": "${CADDY_IMAGE:?required outside Git}",
      "restart": "unless-stopped",
      "networks": {
        "ingress": {
          "aliases": [
            "${PILOT_HOST:?required outside Git}"
          ]
        },
        "application": {
          "aliases": [
            "${PILOT_HOST:?required outside Git}"
          ]
        }
      },
      "ports": [
        {
          "target": 443,
          "published": "443",
          "host_ip": "${INGRESS_IP:?required outside Git}",
          "protocol": "tcp"
        }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "${TLS_CONFIG:?required outside Git}",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true
        },
        "caddy_data:/data",
        "caddy_config:/config",
        {
          "type": "bind",
          "source": "${TLS_CERT:?required outside Git}",
          "target": "/etc/oligospace/tls/cert.pem",
          "read_only": true
        },
        {
          "type": "bind",
          "source": "${TLS_KEY:?required outside Git}",
          "target": "/etc/oligospace/tls/key.pem",
          "read_only": true
        }
      ],
      "depends_on": {
        "web": {
          "condition": "service_started"
        },
        "keycloak": {
          "condition": "service_started"
        }
      },
      "user": "1000:1000",
      "mem_limit": "128m",
      "cpus": "0.5",
      "pids_limit": 80,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "tmpfs": [
        "/tmp:rw,nosuid,noexec,size=64m,mode=1777"
      ],
      "environment": {
        "PILOT_HOST": "${PILOT_HOST:?required outside Git}",
        "OIDC_REALM": "${OIDC_REALM:?required outside Git}"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "caddy",
          "version"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      },
      "cap_add": [
        "NET_BIND_SERVICE"
      ]
    }
  },
  "networks": {
    "ingress": {},
    "application": {
      "internal": true
    },
    "data": {
      "internal": true
    }
  },
  "volumes": {
    "postgres_data": {},
    "redis_data": {},
    "object_data": {},
    "caddy_data": {},
    "caddy_config": {}
  }
}
