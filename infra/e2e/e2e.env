# Test-only values for the isolated E2E stack (`make test-e2e`).
# These are deliberately public placeholders, not secrets: the stack runs on
# ephemeral tmpfs storage, publishes no host port, and is destroyed after each run.
# Never reuse them outside E2E and never point this file at the dev `.env`.
ENVIRONMENT=development
AUTH_MODE=development
APP_ORIGIN=http://oligospace.localhost:8080
APP_PORT=8080
POSTGRES_PASSWORD=e2e-only-not-a-secret-postgres
NEXTAUTH_SECRET=e2e-only-not-a-secret-nextauth-0123456789abcdef
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=e2e-only-not-a-secret-keycloak-admin
KEYCLOAK_CLIENT_SECRET=e2e-only-not-a-secret-keycloak-client
DEVELOPMENT_USER_PASSWORD=e2e-only-not-a-secret-dev-user
MINIO_ROOT_USER=e2e-minio
MINIO_ROOT_PASSWORD=e2e-only-not-a-secret-minio
