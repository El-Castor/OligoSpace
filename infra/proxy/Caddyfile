{$APP_ORIGIN}, http://caddy:8080 {
  encode zstd gzip

  @api path /api/v1/* /docs* /openapi.json
  handle @api {
    reverse_proxy {
      dynamic a api 8000 {
        refresh 5s
        resolvers 127.0.0.11
        versions ipv4
      }
    }
  }

  @identity path /realms/* /resources/* /.well-known/*
  handle @identity {
    reverse_proxy {
      dynamic a keycloak 8080 {
        refresh 5s
        resolvers 127.0.0.11
        versions ipv4
      }
    }
  }

  handle {
    reverse_proxy {
      dynamic a web 3000 {
        refresh 5s
        resolvers 127.0.0.11
        versions ipv4
      }
    }
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }
}
