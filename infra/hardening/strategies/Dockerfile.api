# syntax=docker/dockerfile:1.7
# Qualification experiments only. Pass MINIMAL_BASE as a reviewed digest-pinned
# Debian trixie-slim image; no production Dockerfile is changed.
ARG BASELINE_IMAGE=oligospace-qualification/api:9ebbf2cd993395af2b154efb0b4cf5a76b4dd079
ARG MINIMAL_BASE
ARG PYTHON_BASE=python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ARG UBUNTU_BASE=ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

FROM ${BASELINE_IMAGE} AS baseline

FROM baseline AS strategy-a
USER root
RUN /opt/conda/bin/python -m pip uninstall --yes \
      hatchling hatchutils pathspec trove-classifiers mypy mypy_extensions \
      pytest pytest-asyncio iniconfig pluggy ruff \
    && rm -rf /root/.cache/pip
USER 1000:1000

FROM ${MINIMAL_BASE} AS strategy-b
USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends bash ca-certificates libstdc++6 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 mambauser \
    && useradd --uid 1000 --gid 1000 --create-home mambauser
COPY --from=strategy-a /opt/conda /opt/conda
COPY --from=baseline /bin/micromamba /bin/micromamba
COPY --from=baseline /usr/local/bin/_entrypoint.sh /usr/local/bin/_entrypoint.sh
COPY --from=baseline /usr/local/bin/_activate_current_env.sh /usr/local/bin/_activate_current_env.sh
COPY --from=baseline --chown=1000:1000 /app /app
ENV MAMBA_ROOT_PREFIX=/opt/conda MAMBA_EXE=/bin/micromamba MAMBA_USER=mambauser ENV_NAME=base PYTHONUNBUFFERED=1
WORKDIR /app
USER 1000:1000
ENTRYPOINT ["/usr/local/bin/_entrypoint.sh"]
EXPOSE 8000
CMD ["micromamba", "run", "--name", "base", "uvicorn", "oligospace_api.main:app", "--host", "0.0.0.0", "--port", "8000"]

FROM ${PYTHON_BASE} AS wheel-builder
COPY infra/hardening/locks/build.txt /tmp/build.txt
RUN python -m venv /opt/build \
    && /opt/build/bin/python -m pip install --no-cache-dir --require-hashes -r /tmp/build.txt
COPY apps/api /src
RUN /opt/build/bin/python -m pip wheel --no-deps --no-build-isolation --wheel-dir /wheels /src

FROM ${PYTHON_BASE} AS strategy-c
RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --create-home appuser \
    && python -m venv /opt/venv
COPY infra/hardening/locks/api.txt /tmp/runtime.txt
RUN /opt/venv/bin/python -m pip install --no-cache-dir --require-hashes -r /tmp/runtime.txt
COPY --from=wheel-builder /wheels /wheels
RUN /opt/venv/bin/python -m pip install --no-cache-dir --no-deps /wheels/*.whl \
    && rm -rf /wheels /tmp/runtime.txt
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
USER 1000:1000
EXPOSE 8000
CMD ["uvicorn", "oligospace_api.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Maintained Ubuntu distro Python; separate experimental fourth target.
FROM ${UBUNTU_BASE} AS ubuntu-python
RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends python3.12 python3.12-venv ca-certificates libstdc++6 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

FROM ubuntu-python AS ubuntu-wheel-builder
COPY infra/hardening/locks/build.txt /tmp/build.txt
RUN python3.12 -m venv /opt/build \
    && /opt/build/bin/python -m pip install --no-cache-dir --require-hashes -r /tmp/build.txt
COPY apps/api /src
RUN /opt/build/bin/python -m pip wheel --no-deps --no-build-isolation --wheel-dir /wheels /src

FROM ubuntu-python AS strategy-c-ubuntu
# Official Noble already supplies ubuntu with UID/GID 1000. Verify that
# identity instead of deleting users or creating a colliding account.
RUN test "$(id -u ubuntu)" = 1000 \
    && test "$(id -g ubuntu)" = 1000 \
    && python3.12 -m venv /opt/venv
COPY infra/hardening/locks/api.txt /tmp/runtime.txt
RUN /opt/venv/bin/python -m pip install --no-cache-dir --require-hashes -r /tmp/runtime.txt
COPY --from=ubuntu-wheel-builder /wheels /wheels
RUN /opt/venv/bin/python -m pip install --no-cache-dir --no-deps /wheels/*.whl \
    && rm -rf /wheels /tmp/runtime.txt
COPY --chown=1000:1000 apps/api/alembic.ini /app/alembic.ini
COPY --chown=1000:1000 apps/api/alembic /app/alembic
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
WORKDIR /app
USER 1000:1000
EXPOSE 8000
CMD ["uvicorn", "oligospace_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
