{
  "context": "default",
  "project": "EXPLICIT_PROJECT",
  "compose_file": "/absolute/nonsecret/compose.json",
  "env_file": "/absolute/private/runtime.env",
  "state_dir": "/absolute/private/recovery-state",
  "database_service": "postgres",
  "redis_service": "redis",
  "s3_service": "minio",
  "non_writers": [
    "postgres",
    "redis",
    "minio"
  ],
  "writers": [
    "api",
    "bioinfo-worker",
    "scientific-scheduler",
    "keycloak",
    "web",
    "proxy"
  ],
  "databases": {
    "application": {
      "name": "oligospace",
      "user": "recovery_operator"
    },
    "identity": {
      "name": "keycloak",
      "user": "recovery_operator"
    }
  },
  "buckets": [
    "oligospace-private"
  ],
  "attachment_bucket": "oligospace-private",
  "s3": {
    "endpoint": "127.0.0.1:EXPLICIT_TUNNEL_PORT",
    "secure": false,
    "access_key": "",
    "secret_key": ""
  },
  "external_writers_excluded": false,
  "source_revision": "EXACT_40_CHARACTER_SOURCE_SHA",
  "configuration_files": [],
  "secret_inventory": [
    "BACKUP_KEY",
    "POSTGRES_PASSWORD",
    "KEYCLOAK_DB_PASSWORD",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "OIDC_CLIENT_SECRET",
    "NEXTAUTH_SECRET"
  ]
}
